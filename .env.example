# Copy this file to .env and fill in your keys.

# Required — get one at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional — only needed if you plan to analyze Hindi/Hinglish audio
# via the Sarvam fallback path (get one at https://www.sarvam.ai/)
SARVAM_API_KEY=

# Optional overrides
WHISPER_MODEL=small
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_DIR=vector_db
ENABLE_RAG=false

# Optional: HTTP/SOCKS proxy to route YouTube requests through.
# Useful on cloud hosts where YouTube blocks the server IP.
# Example: PROXY_URL=http://user:pass@proxy.example.com:8080
PROXY_URL=
